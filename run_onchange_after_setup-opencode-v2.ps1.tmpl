{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

# OpenCode v2 sandbox. Runs beside the v1 install that owns ~/.config/opencode
# and ~/.local/share/opencode. Bump $version to reinstall the binary: chezmoi
# reruns this script whenever its rendered content changes.
$version = '2.0.13'

$root = Join-Path $HOME '.opencode-v2'
$binDir = Join-Path $root 'bin'
$exe = Join-Path $binDir 'opencode.exe'
$stamp = Join-Path $binDir '.version'
$v1Config = Join-Path $HOME '.config/opencode'
# Configuration lives under ~/.config so chezmoi manages every OpenCode config
# in one place. Only the binary and runtime state stay in ~/.opencode-v2.
$v2ConfigHome = Join-Path $HOME '.config/opencodev2'

# RTK (Rust Token Killer) shrinks verbose command output before it reaches the
# model. Bump $rtkVersion to upgrade; the same rerun rule as $version applies.
$rtkVersion = '0.49.0'
$rtkBinDir = Join-Path $HOME '.local/bin'
$rtkExe = Join-Path $rtkBinDir 'rtk.exe'
$rtkStamp = Join-Path $rtkBinDir '.rtk-version'

function Get-Target {
    $arch = if ([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture -eq 'Arm64') { 'arm64' } else { 'x64' }
    if ($arch -ne 'x64') { return "windows-$arch" }

    # Bun's x64 build needs AVX2; fall back to the baseline build without it.
    Add-Type -MemberDefinition '[DllImport("kernel32.dll")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);' -Name K32 -Namespace OcV2 -ErrorAction SilentlyContinue
    $avx2 = try { [OcV2.K32]::IsProcessorFeaturePresent(40) } catch { $false }
    if ($avx2) { 'windows-x64' } else { 'windows-x64-baseline' }
}

function Install-Binary {
    # npm install -g @opencode/cli fails on Windows: its postinstall cannot pick
    # the platform package and npm then empties the package directory. Fetch the
    # platform tarball directly, which is what opencode.ai/v2/install also does.
    $target = Get-Target
    $package = "@opencode/cli-$target"
    $url = "https://registry.npmjs.org/$package/-/cli-$target-$version.tgz"
    $work = Join-Path ([System.IO.Path]::GetTempPath()) "opencode-v2-setup-$PID"

    Write-Host "[OpenCode v2] Downloading $package@$version"
    New-Item -ItemType Directory -Path $work -Force | Out-Null
    try {
        Invoke-WebRequest -Uri $url -OutFile (Join-Path $work 'cli.tgz')
        & tar -xzf (Join-Path $work 'cli.tgz') -C $work
        if ($LASTEXITCODE -ne 0) { throw "tar failed with exit code $LASTEXITCODE" }

        New-Item -ItemType Directory -Path $binDir -Force | Out-Null
        # A running opencode.exe (shared service or an active session) cannot be
        # overwritten, but Windows allows renaming it. Park the old binary aside;
        # live processes keep their mapped image and the next launch gets $version.
        $previous = "$exe.previous"
        Remove-Item -LiteralPath $previous -Force -ErrorAction SilentlyContinue
        if (Test-Path -LiteralPath $exe) {
            try {
                Rename-Item -LiteralPath $exe -NewName (Split-Path -Leaf $previous)
            }
            catch {
                # A previous backup may still be mapped by an older client.
                # Keep it and use a versioned backup for this replacement.
                $previous = "$exe.previous.$version"
                Remove-Item -LiteralPath $previous -Force -ErrorAction SilentlyContinue
                Rename-Item -LiteralPath $exe -NewName (Split-Path -Leaf $previous)
            }
        }
        Move-Item (Join-Path $work 'package/bin/opencode.exe') $exe -Force
        Set-Content -LiteralPath $stamp -Value $version -NoNewline
        Write-Host "[OpenCode v2] Installed $version to $exe"
        if (Get-Process opencode -ErrorAction SilentlyContinue) {
            Write-Host "[OpenCode v2] Running opencode processes still use the previous binary. Run 'opencode2 service restart' when convenient."
        }
    }
    finally {
        Remove-Item -Recurse -Force $work -ErrorAction SilentlyContinue
    }
}

function Install-Rtk {
    # Deliberately not added to PATH. opencode/plugins/rtk/index.ts resolves
    # this exact path and injects the directory into the PATH of the one shell
    # it rewrites, so nothing else on the machine has to know rtk exists and
    # removing it never requires an environment-variable edit.
    $asset = 'rtk-x86_64-pc-windows-msvc.zip'
    $base = "https://github.com/rtk-ai/rtk/releases/download/v$rtkVersion"
    $work = Join-Path ([System.IO.Path]::GetTempPath()) "rtk-setup-$PID"

    Write-Host "[OpenCode v2] Downloading rtk $rtkVersion"
    New-Item -ItemType Directory -Path $work -Force | Out-Null
    try {
        $zip = Join-Path $work $asset
        Invoke-WebRequest -Uri "$base/$asset" -OutFile $zip -UseBasicParsing

        # checksums.txt holds one "<sha256>  <asset>" line per artifact, so a
        # version bump stays a one-line edit instead of a hardcoded hash.
        $checksums = Join-Path $work 'checksums.txt'
        Invoke-WebRequest -Uri "$base/checksums.txt" -OutFile $checksums -UseBasicParsing
        $line = Get-Content -LiteralPath $checksums | Where-Object { $_ -match "\s$([regex]::Escape($asset))\s*$" } | Select-Object -First 1
        if (-not $line) { throw "checksums.txt has no entry for $asset" }
        $expected = ($line -split '\s+')[0]
        $actual = (Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash
        if ($actual -ne $expected) { throw "sha256 mismatch for ${asset}: expected $expected, got $actual" }

        Expand-Archive -LiteralPath $zip -DestinationPath $work -Force
        New-Item -ItemType Directory -Path $rtkBinDir -Force | Out-Null
        Move-Item (Join-Path $work 'rtk.exe') $rtkExe -Force
        Set-Content -LiteralPath $rtkStamp -Value $rtkVersion -NoNewline
        Write-Host "[OpenCode v2] Installed rtk $rtkVersion to $rtkExe"
    }
    finally {
        Remove-Item -Recurse -Force $work -ErrorAction SilentlyContinue
    }
}

function Add-UserPath {
    param([Parameter(Mandatory = $true)][string]$Entry)

    $current = [Environment]::GetEnvironmentVariable('PATH', 'User')
    $items = @($current -split ';' | Where-Object { $_ -ne '' })
    if ($items -contains $Entry) {
        Write-Host "[OpenCode v2] PATH already contains $Entry"
        return
    }

    [Environment]::SetEnvironmentVariable('PATH', (($items + $Entry) -join ';'), 'User')
    Write-Host "[OpenCode v2] Added $Entry to the user PATH"
}

function Set-Junction {
    param(
        [Parameter(Mandatory = $true)][string]$Source,
        [Parameter(Mandatory = $true)][string]$Target
    )

    if (-not (Test-Path -LiteralPath $Source)) {
        Write-Host "[OpenCode v2] Skipping $Target, source is missing: $Source"
        return
    }

    if (Test-Path -LiteralPath $Target) {
        $item = Get-Item -LiteralPath $Target -Force
        if ($item.LinkType -eq 'Junction') { return }
        Rename-Item -LiteralPath $Target -NewName "$(Split-Path -Leaf $Target)_backup_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
    }

    New-Item -ItemType Junction -Path $Target -Target $Source | Out-Null
    Write-Host "[OpenCode v2] Junction: $Target -> $Source"
}

function Set-FileLink {
    param(
        [Parameter(Mandatory = $true)][string]$Source,
        [Parameter(Mandatory = $true)][string]$Target
    )

    if (-not (Test-Path -LiteralPath $Source)) {
        Write-Host "[OpenCode v2] Skipping $Target, source is missing: $Source"
        return
    }

    if (Test-Path -LiteralPath $Target) {
        $item = Get-Item -LiteralPath $Target -Force
        if ($item.LinkType -eq 'SymbolicLink') { return }
        Remove-Item -LiteralPath $Target -Force
    }

    New-Item -ItemType SymbolicLink -Path $Target -Target $Source | Out-Null
    Write-Host "[OpenCode v2] Symlink: $Target -> $Source"
}

Write-Host '[OpenCode v2] Starting sandbox setup...'

# Runtime directories. XDG_CONFIG_HOME points at ~/.config/opencodev2, not here,
# so xdg/ holds only the database, credentials, and cache. All of xdg/** is
# excluded in .chezmoiignore.
foreach ($name in 'xdg/data', 'xdg/state', 'xdg/cache') {
    New-Item -ItemType Directory -Path (Join-Path $root $name) -Force | Out-Null
}
New-Item -ItemType Directory -Path (Join-Path $v2ConfigHome 'opencode') -Force | Out-Null

$installed = if (Test-Path -LiteralPath $stamp) { (Get-Content -LiteralPath $stamp -Raw).Trim() } else { '' }
if (-not (Test-Path -LiteralPath $exe) -or $installed -ne $version) {
    Install-Binary
} else {
    Write-Host "[OpenCode v2] Binary $version already installed"
}

$rtkInstalled = if (Test-Path -LiteralPath $rtkStamp) { (Get-Content -LiteralPath $rtkStamp -Raw).Trim() } else { '' }
if (-not (Test-Path -LiteralPath $rtkExe) -or $rtkInstalled -ne $rtkVersion) {
    # rtk only makes output smaller, so a download failure must not fail the
    # setup. The plugin no-ops while the binary is missing.
    try { Install-Rtk }
    catch { Write-Warning "[OpenCode v2] rtk $rtkVersion install failed: $($_.Exception.Message)" }
} else {
    Write-Host "[OpenCode v2] rtk $rtkVersion already installed"
}

Add-UserPath -Entry $root

# agent, commands, and skills stay single-sourced in the v1 config tree so
# chezmoi manages exactly one copy of each markdown file.
# .oh-my-opencode-slim holds the plugin's skills-manifest.json, whose "deleted"
# tombstones keep it from copying its bundled skills into the shared skills/
# junction. The plugin resolves that directory from XDG_CONFIG_HOME, so v2 must
# see the same manifest as v1 or it would reinstall the skills globally.
$v2Config = Join-Path $v2ConfigHome 'opencode'
foreach ($name in 'agent', 'commands', 'skills', '.oh-my-opencode-slim') {
    Set-Junction -Source (Join-Path $v1Config $name) -Target (Join-Path $v2Config $name)
}
Set-FileLink -Source (Join-Path $v1Config 'AGENTS.md') -Target (Join-Path $v2Config 'AGENTS.md')

# The locu plugin is the v2 port of the v1 custom tool. V2 removed file-based
# custom tools, so only the registration layer lives here; the client is shared
# with tools/locu through this junction.
Set-Junction -Source (Join-Path $v1Config 'tools/locu') -Target (Join-Path $v2Config 'plugins/locu/core')

# opencode2.cmd redirects XDG_CONFIG_HOME wholesale, so every tool an agent runs
# loses ~/.config and silently falls back to its own defaults:
#   git     - Git for Windows system config sets core.autocrlf=true and leaves
#             core.safecrlf unset, so commits can rewrite LF to CRLF in
#             repositories that have no .gitattributes.
#   tuios   - writes a full default config whose alt+hjkl and alt+1..9 bindings
#             collide with GlazeWM, instead of the psmux-derived config.
#   scoop   - loses scoop_repo and scoop_branch.
#   chezmoi - loses chezmoi.toml, so an agent cannot reach the dotfile config.
# Bridge them back so a sandboxed session behaves like a normal shell.
foreach ($name in 'git', 'tuios', 'scoop', 'chezmoi') {
    Set-Junction -Source (Join-Path $HOME ".config/$name") -Target (Join-Path $v2ConfigHome $name)
}

# XDG_DATA_HOME is redirected the same way, so tools that keep state in
# ~/.local/share lose it too. chezmoi resolves its source directory from
# $XDG_DATA_HOME/chezmoi and reports "not managed" for every target without
# this bridge. Do not bridge 'opencode' here: that collision is the reason the
# sandbox redirects XDG_DATA_HOME in the first place.
foreach ($name in 'chezmoi') {
    Set-Junction -Source (Join-Path $HOME ".local/share/$name") -Target (Join-Path $root "xdg/data/$name")
}

Write-Host '[OpenCode v2] Complete. Run "opencode2 auth login anthropic --method claude-max" in a new terminal.'
{{- end }}
