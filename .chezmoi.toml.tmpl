# 1. 詢問個人資訊 (只問一次)
{{- $gitName := promptStringOnce . "gitName" "git user name" "TC" }}
{{- $gitEmail := promptStringOnce . "gitEmail" "git user email" "leon8847@gmail.com" }}

# 2. 詢問同步開關
{{- $syncGit := promptBoolOnce . "syncGit" "sync git config" true }}
{{- $syncZsh := promptBoolOnce . "syncZsh" "sync zsh config" false }}
{{- $syncNvim := promptBoolOnce . "syncNvim" "sync neovim config" true }}
{{- $syncPowershell := promptBoolOnce . "syncPowershell" "sync powershell config" true }}
{{- $syncIdeavimrc := promptBoolOnce . "syncIdeavimrc" "sync ideavimrc config" true }}
{{- $autoPush := promptBoolOnce . "autoPush" "auto commit and push dotfile changes" true }}

# 3. 偵測本機工具（dot_zshrc.tmpl 使用）
{{- $hasSnap := ne (lookPath "snap") "" }}
{{- $hasHomebrew := or (stat "/opt/homebrew/bin/brew") (stat "/home/linuxbrew/.linuxbrew/bin/brew") | not | not }}
{{- $hasNvm := stat (joinPath .chezmoi.homeDir ".nvm") | not | not }}

[add]
    templateSymlinks = false

[edit]
    command = "nvim"

[git]
    autoCommit = {{ $autoPush }}
    autoPush = {{ $autoPush }}
    commitMessageTemplate = "Update dotfiles: {{ "{{" }} .chezmoi.hostname {{ "}}" }}"

[hooks.add.pre]
    command = "git"
    args = ["-C", {{ .chezmoi.sourceDir | quote }}, "pull", "--rebase", "--autostash"]

[data]
    gitName = {{ $gitName | quote }}
    gitEmail = {{ $gitEmail | quote }}
    # 同步開關
    syncGit = {{ $syncGit }}
    syncZsh = {{ $syncZsh }}
    syncNvim = {{ $syncNvim }}
    syncPowershell = {{ $syncPowershell }}
    syncIdeavimrc = {{ $syncIdeavimrc }}
    autoPush = {{ $autoPush }}
    # 本機工具偵測（每次 chezmoi init 重新計算）
    has_snap = {{ $hasSnap }}
    has_homebrew = {{ $hasHomebrew }}
    has_nvm = {{ $hasNvm }}

[update]
    apply = true

[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]

[merge]
    command = "code"
    args = ["--wait", "--diff"]
