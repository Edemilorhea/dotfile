{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false, // 1.15.6 is ok
    "instructions": [
        "AGENTS.md"
    ],
    "plugin": [
        "@ex-machina/opencode-anthropic-auth",
        "@franlol/opencode-md-table-formatter@latest",
        "@mohak34/opencode-notifier@latest",
        // "@different-ai/opencode-browser",
        "@tarquinen/opencode-dcp@3.1.14",
        "./plugin/mandatory-format.ts",
        // "./node_modules/@smart-coders-hq/opencode-model-fallback/dist/index.js",
        "opencode-mem",
        "opencode-handoff@0.5.0",
        "opencode-command-inject@1.3.0",
        "@tarquinen/opencode-smart-title@0.1.7",
        "opencode-large-image-optimizer@latest",
        "opencode-chrome-devtools",
        "opencode-openai-codex-auth"
    ],
    "default_agent": "build",
    "disabled_providers": [
        "google",
        "nvidia"
    ],
    "provider": {
        "openai": {
            "options": {
                "headerTimeout": 60000,
                "timeout": 600000,
                "chunkTimeout": 60000
            }
        }
    },
    "mcp": {
        "notebooklm": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "notebooklm-mcp@latest"
            ],
            "enabled": true
        },
        "linear": {
            "type": "remote",
            "url": "https://mcp.linear.app/mcp",
            "enabled": true,
            "timeout": 5000
        },
        "markitdown": {
            "type": "local",
            "command": [
                "markitdown-mcp"
            ],
            "enabled": true
        },
        "office-mcp": {
            "type": "local",
            "command": [
                "C:\\Users\\tc_tseng\\.local\\share\\opencode\\office-mcp\\.venv\\Scripts\\python.exe",
                "C:\\Users\\tc_tseng\\.local\\share\\opencode\\office-mcp\\server.py"
            ],
            "enabled": true,
            "environment": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8",
                "OFFICE_MCP_DEFAULT_FOLDER": "C:\\Users\\tc_tseng\\Documents"
            }
        }
    },
    "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "question": "allow",
        "skill": {
            "change-understanding-review": "allow"
        },
        "edit": "ask",
        "bash": {
            "*": "ask",
            "ls": "allow",
            "ls *": "allow",
            "pwd": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "find *": "ask",
            "which *": "allow",
            "wc *": "allow",
            "du *": "allow",
            "df *": "allow",
            "stat *": "allow",
            "file *": "allow",
            "tree *": "allow",
            "diff *": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "ag *": "allow",
            "Select-String *": "allow",
            "whoami": "allow",
            "hostname": "allow",
            "uname *": "allow",
            "uptime": "allow",
            "date": "allow",
            "env": "allow",
            "printenv": "allow",
            "echo *": "allow",
            "ps *": "allow",
            "curl *": "ask",
            "wget *": "ask",
            "jq *": "allow",
            "yq *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git show*": "allow",
            "git branch": "allow",
            "git branch --list": "allow",
            "git branch --show-current": "allow",
            "git branch -a": "allow",
            "git branch -r": "allow",
            "git branch -v": "allow",
            "git branch -vv": "allow",
            "git remote": "allow",
            "git remote -v": "allow",
            "git config --get*": "allow",
            "git config --list": "allow",
            "dotnet --version": "allow",
            "dotnet --info*": "allow",
            "dotnet --list-*": "allow",
            "dotnet list *": "allow",
            "dotnet sln list": "allow",
            "node --version": "allow",
            "npm --version": "allow",
            "npm list*": "allow",
            "pnpm --version": "allow",
            "pnpm list*": "allow",
            "yarn --version": "allow",
            "bun --version": "allow",
            "python --version": "allow",
            "python3 --version": "allow",
            "pip list": "allow",
            "pip show *": "allow",
            "go version": "allow",
            "cargo --version": "allow",
            "rustc --version": "allow",
            "docker ps*": "allow",
            "docker images*": "allow",
            "docker inspect *": "allow",
            "dotnet build*": "allow",
            "dotnet test*": "allow",
            "npm run *": "ask",
            "npm run test*": "allow",
            "npm run lint*": "allow",
            "npm run check*": "allow",
            "npm run typecheck*": "allow",
            "npm test*": "allow",
            "pnpm run *": "ask",
            "pnpm run test*": "allow",
            "pnpm run lint*": "allow",
            "pnpm run check*": "allow",
            "pnpm run typecheck*": "allow",
            "pnpm test*": "allow",
            "yarn *": "ask",
            "yarn run *": "ask",
            "yarn run test*": "allow",
            "yarn run lint*": "allow",
            "yarn run check*": "allow",
            "yarn run typecheck*": "allow",
            "yarn test*": "allow",
            "git add *": "ask",
            "git commit*": "ask",
            "git push*": "ask",
            "git merge*": "ask",
            "git rebase*": "ask",
            "npm install*": "ask",
            "pnpm install*": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "rm *": "ask",
            "rm -rf *": "ask",
            "rm -rf /*": "deny",
            "sudo rm*": "deny",
            "sudo *": "deny",
            "su *": "deny",
            "> /dev/*": "deny",
            "dd *": "deny",
            "mkfs*": "deny",
            "fdisk*": "deny",
            "shutdown*": "deny",
            "reboot*": "deny",
            "halt*": "deny",
            "poweroff*": "deny",
            "kill -9 *": "deny",
            "killall *": "deny",
            "pkill *": "deny"
        },
        "task": "allow",
        "todoread": "allow",
        "todowrite": "ask",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "external_directory": "ask",
        "doom_loop": "ask"
    },
    "agent": {
        "plan": {
            "model": "anthropic/claude-opus-4-8",
            "permission": {
                "edit": "deny"
            }
        },
        "Navigator": {
            "model": "openai/gpt-5.6-sol"
        },
        "Mentor": {
            "model": "openai/gpt-5.6-sol"
        },
        "Facilitator": {
            "model": "openai/gpt-5.6-sol"
        },
        "Deconstructor": {
            "model": "openai/gpt-5.6-sol"
        },
        "Skeptic": {
            "model": "openai/gpt-5.6-sol"
        },
        "RedTeam": {
            "model": "openai/gpt-5.6-sol"
        },
        "Simplifier": {
            "model": "openai/gpt-5.6-sol"
        },
    }
}
