{{- /* chezmoi:modify-template */ -}}
{{- /*
  chezmoi owns every key in ~/.config/opencode/opencode.json except "plugins"
  and "mcp". The opencode-assets installer (private repository
  Edemilorhea/opencode-assets) owns those two keys, so every machine keeps the
  plugins and MCP servers it chose to install. See OWNERSHIP.md.

  The template keeps the current file byte-for-byte when its content already
  matches, so a rewrite by the installer does not show up as chezmoi drift.
*/ -}}
{{- $base := `
{
    "$schema": "https://opencode.ai/config.json",
    "model": "omniroute/claude-opus",
    "autoupdate": true,
    "compaction": {
        "auto": false,
        "prune": false
    },
    "instructions": [
        "AGENTS.md"
    ],
    "default_agent": "plan",
    "disabled_providers": [
        "google",
        "nvidia"
    ],
    "provider": {
        "openai": {
            "options": {
                "headerTimeout": 60000,
                "timeout": 600000,
                "chunkTimeout": 60000
            }
        }
    },
    "providers": {
        "omniroute": {
            "name": "OmniRoute",
            "env": [
                "OMNIROUTE_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:20128/v1"
            },
            // Each model is an OmniRoute combo: the first target is the main
            // subscription and the second is used only when its quota runs out.
            // Variants send reasoningEffort; the combos hold base models only.
            "models": {
                "claude-opus": {
                    "name": "Claude Opus 5.5 (fallback Codex Sol)",
                    "modelID": "Claude-Opus",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                },
                "claude-fable": {
                    "name": "Claude Fable 5.1 (fallback Codex Sol)",
                    "modelID": "Claude-Fable",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                },
                "claude-sonnet": {
                    "name": "Claude Sonnet 5.5 (fallback Codex Luna)",
                    "modelID": "Claude-Sonnet",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                },
                "codex-sol": {
                    "name": "GPT-6 Sol (fallback Claude Opus)",
                    "modelID": "Codex-Sol",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                },
                "codex-astra": {
                    "name": "GPT-6 Astra (fallback Claude Opus)",
                    "modelID": "Codex-Astra",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                },
                "codex-luna": {
                    "name": "GPT-6 Luna (fallback Claude Sonnet)",
                    "modelID": "Codex-luna",
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
                    ]
                }
            }
        }
    },
    "lsp": true,
    // V2 ordered rules; the last match wins. The base policy already allows
    // every action, so only overrides are listed. cli.json runs with
    // session.permissions "autoaccept", which turns every "ask" into "allow";
    // "deny" is the only effect the server enforces on its own, so the build
    // agent relies on the deny list and the plan agent on a shell allowlist.
    "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        { "action": "shell", "resource": "su *", "effect": "deny" },
        { "action": "shell", "resource": "> /dev/*", "effect": "deny" },
        { "action": "shell", "resource": "dd *", "effect": "deny" },
        { "action": "shell", "resource": "mkfs*", "effect": "deny" },
        { "action": "shell", "resource": "fdisk *", "effect": "deny" },
        { "action": "shell", "resource": "diskpart *", "effect": "deny" },
        { "action": "shell", "resource": "format *", "effect": "deny" },
        { "action": "shell", "resource": "Format-Volume *", "effect": "deny" },
        { "action": "shell", "resource": "Clear-Disk *", "effect": "deny" },
        { "action": "shell", "resource": "shutdown *", "effect": "deny" },
        { "action": "shell", "resource": "reboot *", "effect": "deny" },
        { "action": "shell", "resource": "halt *", "effect": "deny" },
        { "action": "shell", "resource": "poweroff *", "effect": "deny" },
        { "action": "shell", "resource": "Stop-Computer *", "effect": "deny" },
        { "action": "shell", "resource": "Restart-Computer *", "effect": "deny" },
        { "action": "shell", "resource": "kill -9 *", "effect": "deny" },
        { "action": "shell", "resource": "killall *", "effect": "deny" },
        { "action": "shell", "resource": "pkill *", "effect": "deny" }
    ],
    // Only built-in agents are overridden here. Overriding an agent ID that no
    // file defines makes V2 create an empty agent, so the models of the
    // selfmade agents live in their own frontmatter in opencode-assets.
    "agents": {
        // Global rules override the shipped plan policy, so the edit deny is
        // repeated here. Shell is deny-by-default with a read-only allowlist
        // because autoaccept would otherwise approve any write done via pwsh.
        "plan": {
            "model": "omniroute/claude-opus",
            "permissions": [
                { "action": "edit", "resource": "*", "effect": "deny" },
                { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },
                { "action": "shell", "resource": "*", "effect": "deny" },
                { "action": "shell", "resource": "git status *", "effect": "allow" },
                { "action": "shell", "resource": "git diff *", "effect": "allow" },
                { "action": "shell", "resource": "git log *", "effect": "allow" },
                { "action": "shell", "resource": "git show *", "effect": "allow" },
                { "action": "shell", "resource": "git blame *", "effect": "allow" },
                { "action": "shell", "resource": "git branch", "effect": "allow" },
                { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
                { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
                { "action": "shell", "resource": "git branch -a", "effect": "allow" },
                { "action": "shell", "resource": "git branch -r", "effect": "allow" },
                { "action": "shell", "resource": "git branch -v*", "effect": "allow" },
                { "action": "shell", "resource": "git remote", "effect": "allow" },
                { "action": "shell", "resource": "git remote -v", "effect": "allow" },
                { "action": "shell", "resource": "git config --get *", "effect": "allow" },
                { "action": "shell", "resource": "git config --list", "effect": "allow" },
                { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
                { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
                { "action": "shell", "resource": "chezmoi source-path *", "effect": "allow" },
                { "action": "shell", "resource": "chezmoi status *", "effect": "allow" },
                { "action": "shell", "resource": "chezmoi diff *", "effect": "allow" },
                { "action": "shell", "resource": "chezmoi managed *", "effect": "allow" },
                { "action": "shell", "resource": "chezmoi data", "effect": "allow" },
                { "action": "shell", "resource": "rg *", "effect": "allow" },
                { "action": "shell", "resource": "grep *", "effect": "allow" },
                { "action": "shell", "resource": "Select-String *", "effect": "allow" },
                { "action": "shell", "resource": "findstr *", "effect": "allow" },
                { "action": "shell", "resource": "ls *", "effect": "allow" },
                { "action": "shell", "resource": "dir *", "effect": "allow" },
                { "action": "shell", "resource": "tree *", "effect": "allow" },
                { "action": "shell", "resource": "cat *", "effect": "allow" },
                { "action": "shell", "resource": "head *", "effect": "allow" },
                { "action": "shell", "resource": "tail *", "effect": "allow" },
                { "action": "shell", "resource": "wc *", "effect": "allow" },
                { "action": "shell", "resource": "diff *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
                { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Item *", "effect": "allow" },
                { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Command *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Process *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Date *", "effect": "allow" },
                { "action": "shell", "resource": "Get-Location", "effect": "allow" },
                { "action": "shell", "resource": "where.exe *", "effect": "allow" },
                { "action": "shell", "resource": "which *", "effect": "allow" },
                { "action": "shell", "resource": "pwd", "effect": "allow" },
                { "action": "shell", "resource": "whoami", "effect": "allow" },
                { "action": "shell", "resource": "hostname", "effect": "allow" },
                { "action": "shell", "resource": "jq *", "effect": "allow" },
                { "action": "shell", "resource": "yq *", "effect": "allow" },
                { "action": "shell", "resource": "dotnet --version", "effect": "allow" },
                { "action": "shell", "resource": "dotnet --info *", "effect": "allow" },
                { "action": "shell", "resource": "dotnet --list-*", "effect": "allow" },
                { "action": "shell", "resource": "dotnet list *", "effect": "allow" },
                { "action": "shell", "resource": "dotnet sln list", "effect": "allow" },
                { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
                { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
                { "action": "shell", "resource": "node --version", "effect": "allow" },
                { "action": "shell", "resource": "npm --version", "effect": "allow" },
                { "action": "shell", "resource": "npm list *", "effect": "allow" },
                { "action": "shell", "resource": "npm test *", "effect": "allow" },
                { "action": "shell", "resource": "npm run test *", "effect": "allow" },
                { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
                { "action": "shell", "resource": "npm run check *", "effect": "allow" },
                { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm --version", "effect": "allow" },
                { "action": "shell", "resource": "pnpm list *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm run test *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm run lint *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm run check *", "effect": "allow" },
                { "action": "shell", "resource": "pnpm run typecheck *", "effect": "allow" },
                { "action": "shell", "resource": "python --version", "effect": "allow" },
                { "action": "shell", "resource": "pip list", "effect": "allow" },
                { "action": "shell", "resource": "pip show *", "effect": "allow" },
                { "action": "shell", "resource": "go version", "effect": "allow" },
                { "action": "shell", "resource": "cargo --version", "effect": "allow" },
                { "action": "shell", "resource": "docker ps *", "effect": "allow" },
                { "action": "shell", "resource": "docker images *", "effect": "allow" },
                { "action": "shell", "resource": "docker inspect *", "effect": "allow" }
            ]
        },
        "general": {
            "model": "omniroute/claude-opus"
        },
        "explore": {
            "model": "omniroute/claude-sonnet"
        }
    },
    // Replaces the v1 mandatory-format.ts plugin. The builtins already detect a
    // project-local prettier dependency and a biome.json; dprint is not a v2
    // builtin, so it is declared here with mandatory-format.ts's extension list.
    "formatter": {
        "dprint": {
            "command": [
                "dprint",
                "fmt",
                "$FILE"
            ],
            "extensions": [
                ".cjs",
                ".css",
                ".html",
                ".js",
                ".json",
                ".jsx",
                ".md",
                ".mjs",
                ".scss",
                ".toml",
                ".ts",
                ".tsx",
                ".yaml",
                ".yml"
            ]
        }
    }
}
` | fromJsonc -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $current = .chezmoi.stdin | fromJsonc -}}
{{- end -}}
{{- range $key := list "plugins" "mcp" -}}
{{-   if hasKey $current $key -}}
{{-     $_ := set $base $key (get $current $key) -}}
{{-   end -}}
{{- end -}}
{{- if and (.chezmoi.stdin | trim) (eq (toJson $base) (toJson $current)) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{- toPrettyJson $base }}
{{ end -}}
