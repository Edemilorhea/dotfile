{
  "enabled": true,
  "defaults": {
    "fallbackOn": [
      "rate_limit",
      "quota_exceeded",
      "5xx",
      "timeout",
      "overloaded"
    ],
    "cooldownMs": 300000,
    "retryOriginalAfterMs": 900000,
    "maxFallbackDepth": 3
  },
  "agents": {
    "*": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-sonnet-5"
      ]
    },
    "Navigator": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-8"
      ]
    },
    "Facilitator": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-8"
      ]
    },
    "Deconstructor": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-8"
      ]
    },
    "Skeptic": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-6"
      ]
    },
    "RedTeam": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-6"
      ]
    },
    "Simplifier": {
      "fallbackModels": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-4-6"
      ]
    }
  },
  "patterns": [
    "rate limit",
    "ratelimit",
    "usage limit",
    "too many requests",
    "quota exceeded",
    "overloaded",
    "capacity exceeded",
    "credits exhausted",
    "insufficient credit",
    "billing limit",
    "resource exhausted",
    "429",
    "OAuth authentication is currently not allowed for this organization."
  ],
  "logging": true,
  "logLevel": "info"
}
