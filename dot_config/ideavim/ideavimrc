" Rider / IdeaVim 鍵位
" 鍵位盡量與 Neovim（LazyVim + ~/.config/nvim）一致；IDE 獨有功能放在最後一段。

" Leader 鍵設定
let mapleader = "\\"
let maplocalleader = "\\"

" 基本設定
set scrolloff=5
set number
set relativenumber
set clipboard=unnamedplus
set ignorecase
set smartcase
set incsearch
set hlsearch
set timeoutlen=500
set visualbell

" Which-Key 設定
set which-key
set notimeout

" 插件
Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
set NERDTree

" 處理器設定
sethandler <C-V> i:ide n:vim

" ── 編輯習慣（同 nvim lua/core/keymaps.lua）──────────

" 行首 / 行尾
nnoremap H ^
nnoremap L $
xnoremap H ^
xnoremap L $

" Visual 模式跳轉和復原
xnoremap <C-o> <Esc><C-o>
xnoremap <C-i> <Esc><C-i>
xnoremap <C-r> <Esc><C-r>

" Normal 模式新行
nnoremap o o<Esc>
nnoremap O O<Esc>

nnoremap Y y$

" 刪除到黑洞暫存器
nnoremap d "_d
xnoremap d "_d
nnoremap D "_D
nnoremap dd "_dd

" Visual 模式貼上不覆蓋暫存器
xnoremap p pgvy

" Visual 大小寫
xnoremap U gU
xnoremap u gu

" 互換 ' 和 `，讓 'a 直接跳到 mark 的精確位置
nnoremap ' `
xnoremap ' `
onoremap ' `
nnoremap ` '
xnoremap ` '
onoremap ` '

" 插入模式
imap jj <Esc>
inoremap <S-Tab> <C-d>
cnoremap <C-v> <C-r>+
map <C-[> <Esc>

" ── Flash（同 nvim lua/core/plugins.lua）─────────────

nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap t <Action>(flash.till)
xmap t <Action>(flash.till)
nmap T <Action>(flash.till_backward)
xmap T <Action>(flash.till_backward)
nmap ; <Action>(flash.repeat)
xmap ; <Action>(flash.repeat)
nmap , <Action>(flash.repeat_backward)
xmap , <Action>(flash.repeat_backward)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
omap r <Action>(flash.remote)

" ── 程式碼導航（同 LazyVim LSP keymap）──────────────

nnoremap gd :action GotoDeclaration<CR>
nnoremap gy :action GotoTypeDeclaration<CR>
nnoremap gI :action GotoImplementation<CR>
nnoremap gr :action FindUsages<CR>
nnoremap K :action QuickJavaDoc<CR>
nnoremap gK :action ParameterInfo<CR>

" 下一個 / 上一個：參照、診斷、方法
nnoremap ]] :action GotoNextElementUnderCaretUsage<CR>
nnoremap [[ :action GotoPrevElementUnderCaretUsage<CR>
nnoremap ]d :action GotoNextError<CR>
nnoremap [d :action GotoPreviousError<CR>
nnoremap ]f :action MethodDown<CR>
nnoremap [f :action MethodUp<CR>
nnoremap ]m :action MethodDown<CR>
nnoremap [m :action MethodUp<CR>

" 符號
nnoremap <leader>ss :action FileStructurePopup<CR>
nnoremap <leader>sS :action GotoSymbol<CR>

" 程式碼操作
nnoremap <leader>ca :action ShowIntentionActions<CR>
nnoremap <leader>cr :action RenameElement<CR>
nnoremap <leader>cR :action RenameFile<CR>
nnoremap <leader>cf :action ReformatCode<CR>
xmap <leader>cf <Action>(ReformatCode)

" 診斷
nnoremap <leader>xx :action ShowErrorDescription<CR>
nnoremap <leader>xX :action ActivateProblemsViewToolWindow<CR>

" ── 分頁（同 bufferline / LazyVim buffer keymap）─────

nnoremap ]b :action NextTab<CR>
nnoremap [b :action PreviousTab<CR>
nnoremap <leader>bd :action CloseContent<CR>
nnoremap <leader>bo :action CloseAllEditorsButActive<CR>
nnoremap <leader>bl :action CloseAllToTheLeft<CR>
nnoremap <leader>br :action CloseAllToTheRight<CR>
nnoremap <leader>bp :action PinActiveTabToggle<CR>
nnoremap <leader>bP :action CloseAllUnpinnedEditors<CR>
nnoremap <leader>1 :action GoToTab1<CR>
nnoremap <leader>2 :action GoToTab2<CR>
nnoremap <leader>3 :action GoToTab3<CR>
nnoremap <leader>4 :action GoToTab4<CR>
nnoremap <leader>5 :action GoToTab5<CR>
nnoremap <leader>6 :action GoToTab6<CR>
nnoremap <leader>7 :action GoToTab7<CR>
nnoremap <leader>8 :action GoToTab8<CR>
nnoremap <leader>9 :action GoToTab9<CR>

" ── 視窗與分割 ─────────────────────────────────────

nnoremap <C-h> :action PrevSplitter<CR>
nnoremap <C-l> :action NextSplitter<CR>
nnoremap <leader>sv :action SplitVertically<CR>
nnoremap <leader>sh :action SplitHorizontally<CR>
nnoremap <leader>sx :action Unsplit<CR>
nnoremap <leader>wm :action MaximizeEditorInSplit<CR>

" ── 搜尋 / 檔案 / 工具 ─────────────────────────────

nnoremap <leader>ff :action GotoFile<CR>
nnoremap <leader><Space> :action GotoFile<CR>
nnoremap <leader>fb :action Switcher<CR>
nnoremap <leader>fr :action RecentFiles<CR>
nnoremap <leader>fg :action FindInPath<CR>
nnoremap <leader>sg :action FindInPath<CR>
nnoremap <leader>/ :action FindInPath<CR>
nnoremap <leader>fn :action NewElementSamePlace<CR>
nnoremap <leader>e :action SelectInProjectView<CR>
nnoremap <leader>sr :action Replace<CR>
nnoremap <leader>tt :action ActivateTerminalToolWindow<CR>
nnoremap <leader>ft :action ActivateTerminalToolWindow<CR>
nnoremap <leader>tr :action Translation.EditorTranslateAction<CR>
xnoremap <leader>tr :action Translation.EditorTranslateAction<CR>

" 搜尋清除
nnoremap <leader>sc :nohlsearch<CR>

" ── Rider 獨有 ─────────────────────────────────────

" 前往父方法
nnoremap gp :action GotoSuperMethod<CR>

" 關閉全部分頁
nnoremap <leader>cg :action CloseAllEditors<CR>

" 中斷點、執行、偵錯（中斷點用 LazyVim DAP 的 \db）
nnoremap <leader>db :action ToggleLineBreakpoint<CR>
nnoremap <leader>rrm :action ChooseRunConfiguration<CR>
nnoremap <leader>rdm :action ChooseDebugConfiguration<CR>

" 資料庫
nnoremap <leader>doc :action Jdbc.OpenConsole.New.Generate<CR>
nnoremap <leader>dd :action ActivateDatabaseToolWindow<CR>
" 任何位置都可用：先選資料來源，再選既有 console 或新增
nnoremap <leader>dq :action Jdbc.OpenConsole.Any<CR>

" 工具視窗
nnoremap <leader>hwa :action HideAllWindows<CR>
nnoremap <leader>haw :action HideActiveWindow<CR>
nnoremap <leader>hsw :action HideSideWindows<CR>

nnoremap <leader>yfn :action CopyFileName<CR>
xnoremap <leader>so :action OpenCodeCompanion.QuickSend<CR>

" 展開到指定層級：目前區塊 z1 ~ z5，全檔案 za1 ~ za5
nnoremap z1 :action ExpandToLevel1<CR>
nnoremap z2 :action ExpandToLevel2<CR>
nnoremap z3 :action ExpandToLevel3<CR>
nnoremap z4 :action ExpandToLevel4<CR>
nnoremap z5 :action ExpandToLevel5<CR>
nnoremap za1 :action ExpandAllToLevel1<CR>
nnoremap za2 :action ExpandAllToLevel2<CR>
nnoremap za3 :action ExpandAllToLevel3<CR>
nnoremap za4 :action ExpandAllToLevel4<CR>
nnoremap za5 :action ExpandAllToLevel5<CR>

