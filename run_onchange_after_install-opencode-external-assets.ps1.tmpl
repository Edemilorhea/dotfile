{{- if eq .chezmoi.os "windows" -}}
# manifest-hash: {{ include "dot_config/opencode/config/external-assets.json" | sha256sum }}
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

function Invoke-CheckedCommand {
    param(
        [Parameter(Mandatory = $true)][string]$Command,
        [Parameter(Mandatory = $true)][string[]]$Arguments,
        [Parameter(Mandatory = $true)][string]$FailureMessage
    )

    & $Command @Arguments
    if ($LASTEXITCODE -ne 0) {
        throw "$FailureMessage (exit code $LASTEXITCODE)"
    }
}

function Get-ActiveProfiles {
    param([Parameter(Mandatory = $true)]$Manifest)

    $configured = if ([string]::IsNullOrWhiteSpace($env:OPENCODE_ASSET_PROFILES)) {
        @($Manifest.defaultProfiles)
    }
    else {
        @($env:OPENCODE_ASSET_PROFILES.Split(',', [System.StringSplitOptions]::RemoveEmptyEntries))
    }

    $profiles = @($configured | ForEach-Object { $_.Trim() } | Where-Object { $_ } | Select-Object -Unique)
    if ($profiles.Count -eq 0) {
        throw 'At least one external asset profile must be selected.'
    }

    return $profiles
}

function Test-ProfileSelected {
    param(
        [Parameter(Mandatory = $true)]$Asset,
        [Parameter(Mandatory = $true)][string[]]$ActiveProfiles
    )

    $assetProfiles = @($Asset.profiles)
    if ($assetProfiles.Count -eq 0) {
        throw 'Every external asset entry must declare at least one profile.'
    }

    return @($assetProfiles | Where-Object { $ActiveProfiles -contains $_ }).Count -gt 0
}

function Resolve-HomePath {
    param([Parameter(Mandatory = $true)][string]$Path)

    if ($Path -eq '~') {
        return $env:USERPROFILE
    }
    if ($Path.StartsWith('~/') -or $Path.StartsWith('~\')) {
        return Join-Path $env:USERPROFILE $Path.Substring(2)
    }

    return [Environment]::ExpandEnvironmentVariables($Path)
}

function Remove-GlobalProjectScopedSkills {
    param([Parameter(Mandatory = $true)]$Manifest)

    foreach ($asset in @($Manifest.projectScopedAssets)) {
        if ($asset.desiredGlobalState -ne 'absent') {
            continue
        }
        if ([string]::IsNullOrWhiteSpace($asset.repositoryRoot) -or
            [string]::IsNullOrWhiteSpace($asset.globalSkillRoot) -or
            [string]::IsNullOrWhiteSpace($asset.skillSourceRoot)) {
            throw "Project-scoped asset $($asset.id) requires repositoryRoot, globalSkillRoot, and skillSourceRoot."
        }

        $repositoryRoot = Resolve-HomePath $asset.repositoryRoot
        $globalSkillRoot = Resolve-HomePath $asset.globalSkillRoot
        foreach ($skillName in @($asset.skills)) {
            $entryPath = Join-Path $globalSkillRoot $skillName
            if (-not (Test-Path -LiteralPath $entryPath)) {
                continue
            }

            $expectedTarget = [System.IO.Path]::GetFullPath(
                (Join-Path (Join-Path $repositoryRoot $asset.skillSourceRoot) $skillName)
            )
            $entry = Get-Item -LiteralPath $entryPath -Force
            if (-not ($entry.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {
                throw "Refusing to remove non-link global skill entry: $entryPath"
            }

            $resolvedTarget = $entry.ResolveLinkTarget($true).FullName
            if (-not [string]::Equals($resolvedTarget, $expectedTarget, [System.StringComparison]::OrdinalIgnoreCase)) {
                throw "Refusing to remove global skill with unexpected target: $entryPath -> $resolvedTarget"
            }

            Write-Host "Removing project-scoped skill from global exposure: $skillName"
            Remove-Item -LiteralPath $entryPath -Force
        }
    }
}

function Get-GlobalSkillsFromSource {
    param([Parameter(Mandatory = $true)]$Source)

    $lockPath = Join-Path $env:USERPROFILE '.agents\.skill-lock.json'
    if (-not (Test-Path -LiteralPath $lockPath)) {
        return @()
    }

    $lock = Get-Content -LiteralPath $lockPath -Raw | ConvertFrom-Json
    $declaredSkills = @($Source.skills)
    $removeAllFromSource = $declaredSkills -contains '*'
    $matches = foreach ($entry in $lock.skills.PSObject.Properties) {
        $sameSource = $entry.Value.sourceUrl -eq $Source.repository
        $declared = $removeAllFromSource -or $declaredSkills -contains $entry.Name
        if ($sameSource -and $declared) {
            $entry.Name
        }
    }

    return @($matches)
}

function Remove-InactiveGlobalSkills {
    param(
        [Parameter(Mandatory = $true)]$Manifest,
        [Parameter(Mandatory = $true)][string[]]$ActiveProfiles
    )

    $installer = $Manifest.installers.skillsCli
    $installerSpec = "$($installer.package)@$($installer.version)"
    foreach ($source in @($Manifest.skillsCli)) {
        if ((Test-ProfileSelected $source $ActiveProfiles) -or -not $source.pruneWhenInactive) {
            continue
        }
        if ($source.scope -ne 'global') {
            throw 'Automatic pruning currently supports global skills only.'
        }

        $skillNames = @(Get-GlobalSkillsFromSource $source)
        if ($skillNames.Count -eq 0) {
            continue
        }

        Write-Host "Removing inactive global skills from $($source.repository): $($skillNames.Count)"
        $arguments = @('-y', $installerSpec, 'remove', '--global', '--yes', '--skill') + $skillNames
        Invoke-CheckedCommand 'npx' $arguments "Failed to remove inactive skills from $($source.repository)"
    }
}

function Install-SkillsCliAssets {
    param(
        [Parameter(Mandatory = $true)]$Manifest,
        [Parameter(Mandatory = $true)][string[]]$ActiveProfiles
    )

    $sources = @($Manifest.skillsCli | Where-Object { Test-ProfileSelected $_ $ActiveProfiles })
    if ($sources.Count -eq 0) {
        return
    }

    $installer = $Manifest.installers.skillsCli
    if ([string]::IsNullOrWhiteSpace($installer.package) -or [string]::IsNullOrWhiteSpace($installer.version)) {
        throw 'The skills CLI installer requires package and version.'
    }

    $installerSpec = "$($installer.package)@$($installer.version)"
    $tempRoot = Join-Path ([System.IO.Path]::GetTempPath()) "opencode-external-assets-$([guid]::NewGuid())"
    New-Item -ItemType Directory -Path $tempRoot | Out-Null

    try {
        for ($index = 0; $index -lt $sources.Count; $index += 1) {
            $source = $sources[$index]
            $repositoryPath = Join-Path $tempRoot "source-$($index + 1)"
            if ($source.scope -ne 'global') {
                throw 'Skills CLI installation currently supports global scope only.'
            }
            if ([string]::IsNullOrWhiteSpace($source.repository) -or [string]::IsNullOrWhiteSpace($source.revision)) {
                throw 'Each skills CLI source requires repository and revision.'
            }
            if (@($source.skills).Count -eq 0) {
                throw 'Each skills CLI source requires at least one skill name.'
            }

            Invoke-CheckedCommand 'git' @('clone', '--filter=blob:none', '--no-checkout', $source.repository, $repositoryPath) "Failed to clone $($source.repository)"
            Invoke-CheckedCommand 'git' @('-C', $repositoryPath, 'fetch', '--depth', '1', 'origin', $source.revision) "Failed to fetch $($source.revision)"
            Invoke-CheckedCommand 'git' @('-C', $repositoryPath, 'checkout', '--detach', 'FETCH_HEAD') "Failed to checkout $($source.revision)"

            $arguments = @('-y', $installerSpec, 'add', $repositoryPath, '--global', '--yes', '--skill') + @($source.skills)
            Invoke-CheckedCommand 'npx' $arguments "Failed to install skills from $($source.repository)"
        }
    }
    finally {
        Remove-Item -LiteralPath $tempRoot -Recurse -Force -ErrorAction SilentlyContinue
    }
}

function Install-ClaudeAssets {
    param(
        [Parameter(Mandatory = $true)]$Manifest,
        [Parameter(Mandatory = $true)][string[]]$ActiveProfiles
    )

    $command = $Manifest.installers.claudeCode.command
    if ([string]::IsNullOrWhiteSpace($command)) {
        throw 'The Claude Code installer requires a command.'
    }

    foreach ($marketplace in @($Manifest.claudeMarketplaces)) {
        if (-not (Test-ProfileSelected $marketplace $ActiveProfiles)) {
            continue
        }
        if ([string]::IsNullOrWhiteSpace($marketplace.name) -or [string]::IsNullOrWhiteSpace($marketplace.source)) {
            throw 'Each Claude marketplace requires name and source.'
        }

        Invoke-CheckedCommand $command @('plugin', 'marketplace', 'add', $marketplace.source) "Failed to add Claude marketplace $($marketplace.name)"
    }

    foreach ($plugin in @($Manifest.claudePlugins)) {
        if (-not (Test-ProfileSelected $plugin $ActiveProfiles)) {
            continue
        }
        if ([string]::IsNullOrWhiteSpace($plugin.id) -or $plugin.scope -notin @('user', 'project', 'local')) {
            throw 'Each Claude plugin requires id and a valid scope.'
        }

        Invoke-CheckedCommand $command @('plugin', 'install', $plugin.id, '--scope', $plugin.scope) "Failed to install Claude plugin $($plugin.id)"
    }
}

$manifestPath = Join-Path $env:USERPROFILE '.config\opencode\config\external-assets.json'
if (-not (Test-Path -LiteralPath $manifestPath)) {
    throw "External assets manifest not found: $manifestPath"
}

$manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json
if ($manifest.schemaVersion -ne 2) {
    throw "Unsupported external assets schema version: $($manifest.schemaVersion)"
}

$activeProfiles = @(Get-ActiveProfiles $manifest)
Write-Host "Installing external asset profiles: $($activeProfiles -join ', ')"
Remove-GlobalProjectScopedSkills $manifest
Remove-InactiveGlobalSkills $manifest $activeProfiles
Install-SkillsCliAssets $manifest $activeProfiles
Install-ClaudeAssets $manifest $activeProfiles

# Deliberately do not remove assets absent from the inventory.
{{- end -}}
