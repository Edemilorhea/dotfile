{{- if eq .chezmoi.os "windows" -}}
# catalog-hash: {{ include "dot_config/opencode/config/external-assets.json" | sha256sum }}
# manager-hash: {{ include "dot_config/opencode/scripts/opencode-assets.ps1" | sha256sum }}
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$manager = Join-Path $env:USERPROFILE '.config\opencode\scripts\opencode-assets.ps1'
if (-not (Test-Path -LiteralPath $manager)) {
    throw "OpenCode Asset Manager not found: $manager"
}

& pwsh -NoProfile -File $manager apply -Scope global -Profiles core
if ($LASTEXITCODE -ne 0) {
    throw "OpenCode Asset Manager failed (exit code $LASTEXITCODE)"
}
{{- end -}}
